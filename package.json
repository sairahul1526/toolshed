{
  "name": "toolshed",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source launch toolkit (links, waitlist, forms, feedback, status page, analytics) that runs on your own Cloudflare account.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairahul1526/toolshed.git"
  },
  "homepage": "https://github.com/sairahul1526/toolshed#readme",
  "bugs": {
    "url": "https://github.com/sairahul1526/toolshed/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --ip 127.0.0.1 --var ENVIRONMENT:dev",
    "prepare:app": "node scripts/prepare.mjs",
    "typecheck": "node scripts/prepare.mjs && tsc",
    "test": "node scripts/prepare.mjs && vitest run",
    "check": "npm run typecheck && vitest run",
    "e2e:server": "node scripts/e2e-server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:hash": "playwright test -c playwright.hash.config.ts",
    "spike:hash:node": "node spikes/hash/bench-node.mjs",
    "spike:hash:dev": "wrangler dev -c spikes/hash/wrangler.jsonc --port 8799",
    "demo:hash": "cp public/assets/toolshed.css spikes/hash/demo/toolshed.css && wrangler dev -c spikes/hash/demo.wrangler.jsonc --port 8798 --ip 127.0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "1.8.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "better-auth": "1.7.27",
    "hono": "4.13.19",
    "kysely": "0.29.9",
    "kysely-d1": "0.4.0",
    "marked": "18.2.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  }
}
